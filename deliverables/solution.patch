index 00000000..a2146b53
--- /dev/null
+++ b/crates/analyzer/src/plugin/libraries/stdlib/pcre/shape.rs
@@ -0,0 +1,148 @@
+//! Array shapes written to the `$matches` argument of `preg_match_all()`.
+
+use std::collections::BTreeMap;
+use std::sync::Arc;
+
+use mago_codex::ttype::atomic::TAtomic;
+use mago_codex::ttype::atomic::array::TArray;
+use mago_codex::ttype::atomic::array::key::ArrayKey;
+use mago_codex::ttype::atomic::array::keyed::TKeyedArray;
+use mago_codex::ttype::atomic::array::list::TList;
+use mago_codex::ttype::get_int;
+use mago_codex::ttype::get_non_empty_string;
+use mago_codex::ttype::get_string;
+use mago_codex::ttype::union::TUnion;
+use mago_word::word;
+
+use crate::plugin::libraries::stdlib::pcre::pattern::PatternGroups;
+
+const PREG_PATTERN_ORDER: i64 = 1;
+const PREG_SET_ORDER: i64 = 2;
+const PREG_OFFSET_CAPTURE: i64 = 256;
+const PREG_UNMATCHED_AS_NULL: i64 = 512;
+
+/// The types `$matches` can hold once `preg_match_all()` has returned.
+#[derive(Debug, Clone)]
+pub struct MatchesTypes {
+    /// The type right after the call, whatever it returned.
+    pub after_call: TUnion,
+    /// The type when the call found at least one match.
+    pub when_matched: TAtomic,
+}
+
+#[derive(Debug, Clone, Copy)]
+struct MatchFlags {
+    set_order: bool,
+    offset_capture: bool,
+    unmatched_as_null: bool,
+}
+
+impl MatchFlags {
+    fn from_bits(bits: i64) -> Option<Self> {
+        let ordering = PREG_PATTERN_ORDER | PREG_SET_ORDER;
+        let accepted = ordering | PREG_OFFSET_CAPTURE | PREG_UNMATCHED_AS_NULL;
+        if bits & !accepted != 0 || bits & ordering == ordering {
+            return None;
+        }
+
+        Some(Self {
+            set_order: bits & PREG_SET_ORDER != 0,
+            offset_capture: bits & PREG_OFFSET_CAPTURE != 0,
+            unmatched_as_null: bits & PREG_UNMATCHED_AS_NULL != 0,
+        })
+    }
+}
+
+/// Builds the `$matches` types for a call, or `None` when the flags cannot be honored.
+pub fn get_matches_types(groups: &PatternGroups, flags: i64) -> Option<MatchesTypes> {
+    let flags = MatchFlags::from_bits(flags)?;
+    if !flags.set_order {
+        return Some(MatchesTypes {
+            after_call: TUnion::from_atomic(TAtomic::Array(TArray::Keyed(get_pattern_order_shape(
+                groups, flags, false,
+            )))),
+            when_matched: TAtomic::Array(TArray::Keyed(get_pattern_order_shape(groups, flags, true))),
+        });
+    }
+
+    let element = Arc::new(TUnion::from_atomic(TAtomic::Array(TArray::Keyed(get_single_match_shape(groups, flags)))));
+
+    Some(MatchesTypes {
+        after_call: TUnion::from_atomic(TAtomic::Array(TArray::List(TList::new(Arc::clone(&element))))),
+        when_matched: TAtomic::Array(TArray::List(TList::new_non_empty(element))),
+    })
+}
+
+/// The array describing one match in set order: the whole match under `0`, then every group under
+/// its name, if it has one, and its number.
+///
+/// Without `PREG_UNMATCHED_AS_NULL`, PHP drops the groups that follow the last group
+/// taking part in the match, so a key is only guaranteed when it, or a later group,
+/// always takes part.
+fn get_single_match_shape(groups: &PatternGroups, flags: MatchFlags) -> TKeyedArray {
+    let mut items = BTreeMap::new();
+    items.insert(ArrayKey::Integer(0), (false, get_capture_type(!groups.can_be_empty, false, flags)));
+
+    for (index, group) in groups.groups.iter().enumerate() {
+        let optional =
+            !flags.unmatched_as_null && !groups.groups[index..].iter().any(|following| following.always_matched);
+        let capture_type = get_capture_type(!group.can_be_empty, !group.always_matched, flags);
+
+        if let Some(name) = &group.name {
+            items.insert(ArrayKey::String(word(name)), (optional, capture_type.clone()));
+        }
+
+        items.insert(ArrayKey::Integer(group.number as i64), (optional, capture_type));
+    }
+
+    TKeyedArray::new().with_known_items(items).with_non_empty(true)
+}
+
+/// The array filled in pattern order: one list per group, each
+/// holding that group's capture for every match.
+fn get_pattern_order_shape(groups: &PatternGroups, flags: MatchFlags, matched: bool) -> TKeyedArray {
+    let get_captures = |capture_type: TUnion| {
+        let element = Arc::new(capture_type);
+        let list = if matched { TList::new_non_empty(element) } else { TList::new(element) };
+
+        TUnion::from_atomic(TAtomic::Array(TArray::List(list)))
+    };
+
+    let mut items = BTreeMap::new();
+    items.insert(ArrayKey::Integer(0), (false, get_captures(get_capture_type(!groups.can_be_empty, false, flags))));
+
+    for group in &groups.groups {
+        let captures = get_captures(get_capture_type(!group.can_be_empty, !group.always_matched, flags));
+        if let Some(name) = &group.name {
+            items.insert(ArrayKey::String(word(name)), (false, captures.clone()));
+        }
+
+        items.insert(ArrayKey::Integer(group.number as i64), (false, captures));
+    }
+
+    TKeyedArray::new().with_known_items(items).with_non_empty(true)
+}
+
+/// The type of a single capture.
+///
+/// A group that did not take part in the match is reported as an empty string, or as
+/// `null` under `PREG_UNMATCHED_AS_NULL`. `PREG_OFFSET_CAPTURE` pairs every capture
+/// with its offset in the subject.
+fn get_capture_type(non_empty: bool, may_be_unmatched: bool, flags: MatchFlags) -> TUnion {
+    let mut capture_type =
+        if non_empty && (!may_be_unmatched || flags.unmatched_as_null) { get_non_empty_string() } else { get_string() };
+
+    if may_be_unmatched && flags.unmatched_as_null {
+        let mut atomics = capture_type.types.into_owned();
+        atomics.push(TAtomic::Null);
+        capture_type = TUnion::from_vec(atomics);
+    }
+
+    if !flags.offset_capture {
+        return capture_type;
+    }
+
+    let pair = TList::from_known_elements(BTreeMap::from([(0, (false, capture_type)), (1, (false, get_int()))]));
+
+    TUnion::from_atomic(TAtomic::Array(TArray::List(pair)))
+}
