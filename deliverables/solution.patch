@@ -0,0 +1,78 @@
+//! `$matches` typing for `preg_match_all()`.
+//!
+//! When the pattern and the flags of a call are literals, the groups of the pattern
+//! decide which keys the `$matches` argument holds once the call returns. That shape
+//! replaces the declared out type, and is narrowed further wherever the call is known
+//! to have matched.
+
+use mago_codex::assertion::Assertion;
+use mago_codex::ttype::union::TUnion;
+use mago_word::word;
+
+use crate::plugin::context::InvocationInfo;
+use crate::plugin::context::ProviderContext;
+use crate::plugin::libraries::stdlib::pcre::pattern::analyze_pattern;
+use crate::plugin::libraries::stdlib::pcre::shape::MatchesTypes;
+use crate::plugin::libraries::stdlib::pcre::shape::get_matches_types;
+use crate::plugin::provider::Provider;
+use crate::plugin::provider::ProviderMeta;
+use crate::plugin::provider::assertion::FunctionAssertionProvider;
+use crate::plugin::provider::assertion::InvocationAssertions;
+use crate::plugin::provider::function::FunctionTarget;
+
+static META: ProviderMeta = ProviderMeta::new(
+    "php::pcre::matches",
+    "PCRE matches",
+    "Types the matches of preg_match_all() from the groups of a literal pattern.",
+);
+
+#[derive(Default)]
+pub struct PregMatchesAssertionProvider;
+
+impl Provider for PregMatchesAssertionProvider {
+    fn meta() -> &'static ProviderMeta {
+        &META
+    }
+}
+
+impl FunctionAssertionProvider for PregMatchesAssertionProvider {
+    fn targets() -> FunctionTarget {
+        FunctionTarget::Exact(b"preg_match_all")
+    }
+
+    fn get_assertions(
+        &self,
+        context: &ProviderContext<'_, '_, '_>,
+        invocation: &InvocationInfo<'_, '_, '_>,
+    ) -> Option<InvocationAssertions> {
+        let metadata = invocation.inner().target.get_function_like_metadata()?;
+        if !metadata.flags.is_built_in() {
+            return None;
+        }
+
+        let pattern = invocation.get_argument(0, &[b"pattern"])?;
+        let flags = invocation.get_argument(3, &[b"flags"]);
+        let types =
+            get_types(context.get_expression_type(pattern), flags.map(|flags| context.get_expression_type(flags)))?;
+
+        let mut assertions = InvocationAssertions::new();
+        assertions.add_out_type(word("$matches"), types.after_call);
+        assertions.add_if_true(word("$matches"), vec![Assertion::IsType(types.when_matched)]);
+
+        Some(assertions)
+    }
+}
+
+/// Resolves the `$matches` types of a call from the types of its pattern and flags.
+///
+/// `flags` is `None` when the argument is omitted, and holds `None` when its type is
+/// not known.
+fn get_types(pattern: Option<&TUnion>, flags: Option<Option<&TUnion>>) -> Option<MatchesTypes> {
+    let groups = analyze_pattern(pattern?.get_single_literal_string_value()?)?;
+    let flags = match flags {
+        Some(flags) => flags?.get_single_literal_int_value()?,
+        None => 0,
+    };
+
+    get_matches_types(&groups, flags)
+}
