+#[test]
+fn preg_match_all_matches_named_groups_are_keyed_by_name_and_number() {
+    run(
+        "preg_match_all_matches_named_groups_are_keyed_by_name_and_number",
+        r"
+function check(string $subject): void
+{
+    $matches = [];
+    preg_match_all('/(?<slot>\{\{(?<slotname>\w+)\}\})/', $subject, $matches);
+
+    foreach ($matches['slot'] as $slot) {
+        takes_string($slot);
+    }
+
+    foreach ($matches['slotname'] as $name) {
+        takes_string($name);
+    }
+
+    foreach ([$matches[0], $matches[1], $matches[2]] as $captures) {
+        foreach ($captures as $capture) {
+            takes_string($capture);
+        }
+    }
+}
+",
+    );
+}
