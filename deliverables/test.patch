+#!/usr/bin/env bash
+set -uo pipefail
+cd "$(dirname "$0")"
+
+MODE=""
+OUTPUT_PATH=""
+while [ $# -gt 0 ]; do
+  case "$1" in
+    --output_path) OUTPUT_PATH="${2:-}"; shift 2 ;;
+    --output_path=*) OUTPUT_PATH="${1#*=}"; shift ;;
+    base|new) MODE="$1"; shift ;;
+    *) shift ;;
+  esac
+done
+
+if [ -z "$MODE" ] || [ -z "$OUTPUT_PATH" ]; then
+  echo "usage: test.sh --output_path <file> base|new" >&2
+  exit 2
+fi
+
+mkdir -p "$(dirname "$OUTPUT_PATH")"
+
+export CARGO_TERM_COLOR=never NO_COLOR=1 TZ=UTC LC_ALL=C RUST_BACKTRACE=0
+
+case "$MODE" in
+  base) TARGETS=(--lib --test mod --test external_throw_type_providers --test unhandled_thrown_type_order) ;;
+  new) TARGETS=(--test preg_match_all_matches) ;;
+esac
+
+RAW_LOG="$(mktemp)"
+LOG="$(mktemp)"
+trap 'rm -f "$RAW_LOG" "$LOG"' EXIT
+
+cargo test --offline --locked --no-fail-fast -p mago-analyzer "${TARGETS[@]}" >"$RAW_LOG" 2>&1
+status=$?
+
+# Failure output can carry bytes that are not legal in XML 1.0.
+tr -d '\000-\010\013\014\016-\037' <"$RAW_LOG" >"$LOG"
+cat "$LOG"
+
+awk -v status="$status" '
+  function escape(text) {
+    gsub(/&/, "\\&amp;", text); gsub(/</, "\\&lt;", text); gsub(/>/, "\\&gt;", text); gsub(/"/, "\\&quot;", text)
+    return text
+  }
+  /^ +Running / {
+    suite = $2
+    if (suite == "unittests") suite = $3
+    next
+  }
+  /^---- .* stdout ----$/ {
+    capturing = substr($0, 6, length($0) - 17)
+    next
+  }
+  /^failures:$/ || /^test result: / { capturing = "" }
+  capturing != "" { output[capturing] = output[capturing] $0 "\n"; next }
+  /^test .* \.\.\. (ok|FAILED|ignored)$/ {
+    name = $0
+    sub(/^test /, "", name)
+    result = name
+    sub(/^.* \.\.\. /, "", result)
+    sub(/ \.\.\. (ok|FAILED|ignored)$/, "", name)
+    count++
+    names[count] = name; suites[count] = suite; results[count] = result
+    if (result == "FAILED") failures++
+    if (result == "ignored") skipped++
+  }
+  END {
+    harness = (count == 0 || (status != 0 && failures == 0)) ? 1 : 0
+    print "<?xml version=\"1.0\" encoding=\"UTF-8\"?>"
+    printf "<testsuites>\n<testsuite name=\"mago-analyzer\" tests=\"%d\" failures=\"%d\" skipped=\"%d\">\n", count + harness, failures + harness, skipped
+    for (i = 1; i <= count; i++) {
+      printf "<testcase classname=\"%s\" name=\"%s\">", escape(suites[i]), escape(names[i])
+      if (results[i] == "FAILED") printf "<failure message=\"test failed\">%s</failure>", escape(output[names[i]])
+      if (results[i] == "ignored") printf "<skipped/>"
+      print "</testcase>"
+    }
+    if (harness) {
+      print "<testcase classname=\"harness\" name=\"cargo_test\"><failure message=\"cargo test did not report its tests\">exit status " status "</failure></testcase>"
+    }
+    print "</testsuite>\n</testsuites>"
+  }
+' "$LOG" >"$OUTPUT_PATH"
+
+exit "$status"
