+#[allow(dead_code)]
+mod framework;
+
+use crate::framework::TestCase;
+
+const HELPERS: &str = r"<?php
+
+declare(strict_types=1);
+
+function takes_string(string $_): void {}
+
+/** @param non-empty-string $_ */
+function takes_non_empty_string(string $_): void {}
+
+function takes_int(int $_): void {}
+
+/** @param non-empty-list<mixed> $_ */
+function takes_non_empty_list(array $_): void {}
+";
+
+fn run(name: &str, body: &str) {
+    let content = format!("{HELPERS}\n{body}");
+
+    TestCase::new(name, content.as_bytes()).run();
+}
